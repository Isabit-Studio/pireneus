<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         IgnorableNamespaces="uap">
  <Identity Name="Pireneus.Examples" Publisher="@PIRENEUS_UWP_PUBLISHER@" Version="1.0.0.0" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>Pireneus</DisplayName>
    <PublisherDisplayName>Pireneus</PublisherDisplayName>
    <Logo>Logos\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Applications>
    <Application Id="App" Executable="pireneus-examples.exe" EntryPoint="Pireneus.App">
      <uap:VisualElements DisplayName="Pireneus" Description="The Pireneus engine's examples and editor" BackgroundColor="#181C24"
                          Square150x150Logo="Logos\Square150x150Logo.png" Square44x44Logo="Logos\Square44x44Logo.png">
        <uap:SplashScreen Image="Logos\SplashScreen.png" />
      </uap:VisualElements>
    </Application>
  </Applications>
</Package>
